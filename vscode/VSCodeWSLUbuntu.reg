Windows Registry Editor Version 5.00

[HKEY_CLASSES_ROOT\Directory\shell\VSCodeWSLUbuntu]
@="Open with Code (Ubuntu)"
"Icon"="%USERPROFILE%\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"
[HKEY_CLASSES_ROOT\Directory\shell\VSCodeWSLUbuntu\command]
@="wsl.exe -d Ubuntu bash -lc \"code \\\"$(wslpath -au '%1')\\\"\""

[HKEY_CLASSES_ROOT\Directory\Background\shell\VSCodeWSLUbuntu]
@="Open with Code (Ubuntu)"
"Icon"="%USERPROFILE%\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"
[HKEY_CLASSES_ROOT\Directory\Background\shell\VSCodeWSLUbuntu\command]
@="wsl.exe -d Ubuntu bash -lc \"code \\\"$(wslpath -au '%V')\\\"\""

[HKEY_CLASSES_ROOT\*\shell\VSCodeWSLUbuntu]
@="Open with Code (Ubuntu)"
"Icon"="%USERPROFILE%\\AppData\\Local\\Programs\\Microsoft VS Code\\Code.exe"
[HKEY_CLASSES_ROOT\*\shell\VSCodeWSLUbuntu\command]
@="wsl.exe -d Ubuntu bash -lc \"code \\\"$(wslpath -au '%1')\\\"\""
